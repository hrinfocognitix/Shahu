# Copy this file to .env.local for development or .env.production for deployment.
# Never commit real credentials. Set production secrets in the host's secret manager.
NODE_ENV=development
HOST=0.0.0.0
PORT=5001
# Comma-separated values are supported. Keep your production Vercel URL here.
CLIENT_ORIGIN=http://localhost:5173
# Allows Vercel preview URLs beginning with this project slug, e.g. shahuacademy-*.vercel.app.
VERCEL_PROJECT_SLUG=shahuacademy
MONGO_URI=mongodb://127.0.0.1:27017/shahuApp?retryWrites=false
CLOUDINARY_CLOUD_NAME=eu25fwnl
CLOUDINARY_API_KEY="679594362855479"
CLOUDINARY_API_SECRET="ul4aTeGnYV-nXEIjNkOrJ11DfuU"
# Alternatively, use one Render secret (do not set both styles):
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OTP_HMAC_SECRET=replace-with-a-third-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-email-app-password
SMTP_FROM="Shahu Academy hrinfocognitix@gmail.com"
RAZORPAY_KEY_ID=replace-with-existing-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-existing-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret
# Used only by Razorpay Standard Checkout. Keep existing RAZORPAY_* values for
# QR payments and legacy checkout records.
RAZORPAY_STANDARD_CHECKOUT_KEY_ID=replace-with-standard-checkout-key-id
RAZORPAY_STANDARD_CHECKOUT_KEY_SECRET=replace-with-standard-checkout-secret
